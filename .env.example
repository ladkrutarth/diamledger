# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_PROVIDER: "gemini" (default) or "huggingface".
AI_PROVIDER="gemini"
# HF_TOKEN: Hugging Face access token (needs "Make calls to Inference Providers").
# Create one at https://huggingface.co/settings/tokens. Used when AI_PROVIDER=huggingface.
HF_TOKEN=""
# HF_MODEL: any chat model that supports tool calling on Inference Providers.
HF_MODEL="meta-llama/Llama-3.3-70B-Instruct"

# APP_URL: the site's public address, like https://app.example.com. Password-reset, buyer-portal and
# payment links are built from it. Required in production (the server will not start without it); on
# Vercel it falls back to the project's production domain. In development, links use the request's host.
# AI Studio injects this at runtime with the Cloud Run service URL.
APP_URL=""

# Session cookie sent over HTTPS only. Defaults to on in production and on Vercel. Set "false" only to try
# a production build over plain http.
# COOKIE_SECURE=""

# Read the client address from X-Forwarded-For (used for rate limits). Turn on only behind a proxy or load
# balancer that sets that header (nginx, Cloud Run, ...); on by default on Vercel. Without a proxy, leave
# it off: anyone could put any address in the header and dodge the sign-in limit.
# TRUST_PROXY=""

# PostgreSQL connection used by the API.
DATABASE_URL="postgresql://diamondx:diamondx@localhost:5432/diamondx"

# Secret used to sign the login session cookie.
SESSION_SECRET="replace-with-a-long-random-string"

# Mail server for password reset emails. Without it, reset links are printed to the server log.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Demo account owner@example.com / password123. Always on in development; off in production (APP_ENV=production) unless "true".
SEED_DEMO_USER=""
# Show the demo credentials on the sign-in page of a production build. Read at build time.
VITE_SHOW_DEMO_LOGIN=""

# Bearer token Vercel Cron sends to /api/cron/rates (daily exchange rates). Without it the cron is refused.
CRON_SECRET=""

# Razorpay subscriptions (monthly and yearly plans in INR). Use test keys (rzp_test_...) until you go live.
# Dashboard → Account & Settings → API keys. Without them the plans page shows but checkout is off.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Webhooks: URL https://<your site>/api/billing/webhook, events subscription.*; paste its secret here.
RAZORPAY_WEBHOOK_SECRET=""

# Buyers paying invoices online (UPI, debit/credit cards, net banking) go through each company's OWN Razorpay
# account, connected under Collections. Its key secret and webhook secret are encrypted in the database with
# this key: any random string of 32+ characters (`openssl rand -base64 32`). Without it, online invoice
# payment stays off (bank transfer still works). Keep it secret and stable: changing it makes stored keys
# unreadable and every company must enter its Razorpay keys again. Each company's webhook (shown in the app)
# should send payment.authorized and payment.captured.
ENCRYPTION_KEY=""

# Two-step sign-in by text message (Twilio). Without these, development logs the code instead of texting it,
# and production offers only authenticator apps. The authenticator-app option needs ENCRYPTION_KEY (above).
# For Indian numbers, SMS needs a DLT-registered sender and template; a Twilio Messaging Service can handle that.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Either a sending number (+1...) or a Messaging Service SID (MG...).
TWILIO_FROM_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""

# Bank transfer (NEFT / RTGS / IMPS) for plan payments. On when the account number and IFSC are set.
BILLING_BANK_ACCOUNT_NAME=""
BILLING_BANK_NAME=""
BILLING_BANK_ACCOUNT_NUMBER=""
BILLING_BANK_IFSC=""
BILLING_BANK_BRANCH=""
BILLING_BANK_ACCOUNT_TYPE="Current"
BILLING_GSTIN=""
# Comma-separated emails of the people who check bank transfers and approve them (Bank transfers page).
PLATFORM_ADMIN_EMAILS=""

# PayPal for customers outside India (US dollars). developer.paypal.com → Apps & Credentials.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# "sandbox" (default) or "live".
PAYPAL_ENV="sandbox"

# Set to "false" to skip database migrations on startup and run `npm run migrate` yourself.
MIGRATE_ON_START=""
# Connection pool. Defaults: 3 connections per serverless instance (Vercel), 10 elsewhere.
# DB_POOL_MAX=""
# DB_IDLE_TIMEOUT_MS=""
# DB_CONNECT_TIMEOUT_MS=""
# Longest a single query may run before the client gives up (default 60000).
# DB_QUERY_TIMEOUT_MS=""
# Certificates of non-local databases are verified. Set to "false" only for a self-signed certificate.
# DATABASE_SSL_VERIFY=""

# Sentry error reporting. Leave empty to turn it off.
SENTRY_DSN=""
# Browser errors. Read at build time.
VITE_SENTRY_DSN=""

# Use an existing PostgreSQL database for `npm run test:api` instead of starting a temporary one. Its tables are wiped.
TEST_DATABASE_URL=""

# "production" turns on CSP and HSTS, hides the API docs at /api/docs, and serves the built frontend (dist/).
APP_ENV=""
