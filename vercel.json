{
  "framework": "vite",
  "installCommand": "npm install --omit=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__path=:path*" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "db/**",
      "maxDuration": 15
    }
  }
}
