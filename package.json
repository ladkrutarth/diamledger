{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "sh -c 'npm run dev:api & npm run dev:web; wait'",
    "dev:api": "cd backend && PORT=${API_PORT:-8000} uv run python -m diamondx.main",
    "dev:web": "API_PROXY_TARGET=${API_PROXY_TARGET:-http://localhost:8000} vite --port 3000",
    "start": "cd backend && APP_ENV=production uv run python -m diamondx.main",
    "build": "vite build",
    "migrate": "cd backend && uv run python -m diamondx.core.migrate",
    "seed:demo": "cd backend && uv run python -m diamondx.core.seed",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "test": "vitest run src",
    "test:api": "cd backend && uv run pytest"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@sentry/node": "^11.10.0",
    "@sentry/react": "^11.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "embedded-postgres": "^18.6.0-beta.19",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
